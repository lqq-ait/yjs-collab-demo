{
  "name": "yjs-collab-demo",
  "version": "0.1.0",
  "description": "Minimal real-time collaborative editor demo using Yjs CRDT + Hocuspocus + WebSocket",
  "type": "module",
  "scripts": {
    "server": "node server.mjs",
    "client": "npx --yes serve client -p 5173",
    "start": "concurrently -n server,client -c green,cyan \"npm run server\" \"npm run client\"",
    "test": "node --test --test-timeout=15000 test/sync.test.mjs",
    "test:browser": "node --test --test-timeout=15000 test/browser-shape.test.mjs"
  },
  "keywords": [
    "yjs",
    "crdt",
    "hocuspocus",
    "real-time-collaboration",
    "websocket",
    "shared-editing"
  ],
  "license": "MIT",
  "author": "Liqq",
  "dependencies": {
    "@hocuspocus/server": "^3.4.4",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.0.0",
    "concurrently": "^9.0.0",
    "ws": "^8.20.0"
  }
}
